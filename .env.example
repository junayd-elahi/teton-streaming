# Copy to .env and load with: set -a; source .env; set +a
DATABASE_URL=postgres://teton:teton@localhost:5432/teton?pool_max_conns=16
LISTEN_ADDR=127.0.0.1:8080
INGEST_WRITERS=4
INGEST_QUEUE_SIZE=5000
INGEST_PRIORITY_QUEUE_SIZE=10000
INGEST_BATCH_SIZE=500
INGEST_LINGER_MS=5
INGEST_ENQUEUE_TIMEOUT_MS=4000
INGEST_COMMIT_TIMEOUT_MS=5000
GOGC=400
